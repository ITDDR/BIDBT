with clients as (

    select *
    from {{ ref('int_clients') }}

),

canaux_acquisition as (

    select *
    from {{ ref('stg_gsheets__canaux_acquisition') }}

),

clients_with_canal as (

    select
        clients.idClient,
        clients.provenance,
        clients.nomFamille,
        clients.idClient_chefFamille,
        clients.creation_datetime,
        canaux_acquisition.famille_canal

    from clients
    left join canaux_acquisition
        on clients.provenance = canaux_acquisition.provenance

),

provenance_counts as (

    select
        idClient_chefFamille,
        coalesce(provenance, 'NULL') as provenance,
        count(*) as nb_clients_provenance

    from clients_with_canal
    where idClient_chefFamille is not null

    group by idClient_chefFamille, provenance

),

provenances_agg as (

    select
        idClient_chefFamille,
        string_agg(
            provenance || ' (' || cast(nb_clients_provenance as string) || ')',
            ', '
            order by nb_clients_provenance desc
        ) as provenances_famille

    from provenance_counts
    group by idClient_chefFamille

),

family_groups as (

    select
        idClient_chefFamille,
        count(*) - 1 as nb_autres_clients_famille,
        logical_or(upper(famille_canal) = 'PARTENARIAT') as a_un_membre_partenaire

    from clients_with_canal
    where idClient_chefFamille is not null

    group by idClient_chefFamille

)

select
    extract(year from clients.creation_datetime) as annee_creation,
    extract(month from clients.creation_datetime) as mois_creation,
    clients.nomFamille,
    provenances_agg.provenances_famille as provenances_famille,

    clients.idClient_chefFamille,
    clients.provenance as provenance_chef,
    family_groups.nb_autres_clients_famille

from clients
inner join family_groups
    on clients.idClient_chefFamille = family_groups.idClient_chefFamille
inner join provenances_agg
    on clients.idClient_chefFamille = provenances_agg.idClient_chefFamille

where clients.idClient = clients.idClient_chefFamille
    and family_groups.a_un_membre_partenaire
    and family_groups.nb_autres_clients_famille > 1
